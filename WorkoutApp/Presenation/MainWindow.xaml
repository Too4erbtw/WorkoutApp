<Window x:Class="WorkoutApp.Presentation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Workout Journal"
        Height="450" Width="600">

    <StackPanel Margin="10">

        <TextBlock Text="Тип тренировки" />
        <TextBox x:Name="TypeTextBox"/>

        <TextBlock Text="Id" />
        <TextBox x:Name="IdTextBox"/>

        <TextBlock Text="Длительность" />
        <TextBox x:Name="DurationTextBox"/>

        <TextBlock Text="Дата (yyyy-mm-dd)" />
        <TextBox x:Name="DateTextBox"/>

        <TextBlock Text="Комментарий" />
        <TextBox x:Name="CommentTextBox"/>

        <Button Content="Добавить тренировку"
                Margin="0,10,0,0"
                Click="AddWorkout_Click"/>

        <TextBlock x:Name="ResultTextBlock"
                   Margin="0,10,0,0"
                   Foreground="Red"/>
    </StackPanel>
</Window>
